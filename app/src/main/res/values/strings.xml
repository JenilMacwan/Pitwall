    <string name="privacy_short_rights">Your Rights</string>
    <string name="privacy_section_storage_title">Data Storage &amp; Paddock Profiles</string>
    <string name="privacy_section_storage_body">User choices — dark mode, favorite constructor theme, regional language, and cached F1 data — are stored locally on your device using Jetpack DataStore and Room SQLite database. If you choose to register or sign in with a Paddock Profile, your display name, profile photo URL, and favorite driver/team selections are securely processed via Firebase Authentication and stored in Firebase Cloud Firestore solely to synchronize your profile and personalized alerts.</string>
    <string name="privacy_section_permissions_title">System Permissions Used</string>
    <string name="privacy_section_permissions_body">• Calendar Access: Used strictly to sync Grand Prix race schedules to your device\'s system calendar upon your explicit request.\n\n• Notifications &amp; Exact Alarms: Used to trigger precise reminders before race sessions begin (FP1-3, Qualifying, Sprint, Race) via Android AlarmManager and deliver push alerts for breaking F1 news, standings updates, and live race weekend events.</string>
    <string name="privacy_section_third_party_title">Third-Party Services &amp; APIs</string>
    <string name="privacy_section_third_party_body">• Firebase &amp; Google Authentication: Handles secure credential management, password hashing, Google Sign-In, and cloud profile storage.\n\n• Firebase Cloud Messaging (FCM): Delivers optional push notifications for breaking F1 news and live alerts.\n\n• Public F1 APIs &amp; Streams: Fetches public Formula 1 session schedules, driver/constructor standings, race results, and live team radio audio transmissions.</string>
    <string name="privacy_section_apex_title">Apex AI Strategy Assistant</string>
    <string name="privacy_section_apex_body">PitWall features \'Apex\', an AI strategy specialist powered by Google Gemini. When you interact with Apex, your text prompts are transmitted securely via HTTPS to our backend API to generate strategy responses. Chat sessions are held temporarily in memory to maintain conversational context. We do not sell conversational data or use your private prompts to train AI models.</string>
    <string name="privacy_section_analytics_title">Analytics &amp; App Stability</string>
    <string name="privacy_section_analytics_body">To maintain high performance and resolve crashes, PitWall uses Firebase Analytics to aggregate anonymous operational metrics (e.g. device model, Android OS version, crash logs). This data contains no sensitive personal information and is used exclusively to fix bugs and improve performance.</string>
    <string name="privacy_section_rights_title">Your Choices &amp; Control</string>
    <string name="privacy_section_rights_body">You are always in control. You can use PitWall anonymously as a Paddock Guest without an account. You can sign out or clear synced calendar events at any time from Settings → Clear F1 Events. Notification categories can be toggled individually. Revoking permissions in Android settings simply disables the associated feature while the rest of PitWall keeps working normally.</string>
    <string name="privacy_trust_no_account">Guest &amp; Account Mode</string>
    <string name="privacy_trust_local_first">Local First &amp; Cloud Sync</string>
    <string name="privacy_trust_no_data_selling">Zero Data Selling</string>
    <string name="privacy_share_subject">PitWall — Privacy Policy</string>
    <string name="privacy_share_text">Read PitWall\'s Privacy Policy: https://pitwall-apex.vercel.app/privacy</string>
    <string name="privacy_share_chooser">Share Privacy Policy</string>
